# 运行环境
FLASK_ENV=development
FLASK_SECRET_KEY=请替换为高强度随机值
# 启用控制台认证时必填，留空会在启动时直接报错
CONSOLE_PASSWORD=请替换为控制台密码
CONSOLE_AUTH_ENABLED=true
# 余额、持仓、交易记录、模型推理、指令与记忆均允许访客只读访问
CONSOLE_READONLY_AUTH_ENABLED=false
# 如需登录后才能查看上述数据，请将 CONSOLE_READONLY_AUTH_ENABLED 设为 true
CONSOLE_SESSION_TTL_MINUTES=60
# 通过 HTTPS 对外提供控制台时必须设为 true（production 环境默认即为 true）
SESSION_COOKIE_SECURE=false
CUSTOM_INSTRUCTIONS_MAX_CHARS=10000
TIMEZONE=+8

# 交易模式：默认 paper。实盘必须同时填写确认值。
TRADING_MODE=paper
# LIVE_TRADING_CONFIRMATION=I_UNDERSTAND_REAL_ORDERS
BINANCE_TESTNET=false
BINANCE_API_KEY=
BINANCE_API_SECRET=
EXCHANGE_TIMEOUT_SECONDS=15
BINANCE_RECV_WINDOW_MS=10000

# 持久化模拟账户
PAPER_INITIAL_BALANCE_USDT=10000
PAPER_TAKER_FEE_RATE=0.0004
PAPER_DEFAULT_LEVERAGE=1

# AI 提供商 1
AI_1_API_KEY=your_api_key_here
AI_1_BASE_URL=https://api.deepseek.com/v1
AI_1_MODEL=deepseek-chat
AI_TIMEOUT_SECONDS=60
AI_MAX_RETRIES=2
AI_MAX_TOOL_CALLS=10
# 记忆白板上限受 AI_MAX_RESPONSE_TOKENS 约束，两者不匹配时启动即报错
AI_MAX_MEMORY_CHARS=4000
# 单次响应的 token 上限，需容纳分析、决策与记忆白板
AI_MAX_RESPONSE_TOKENS=8000
# 提示词字符上限，超出则不发起请求，避免超出模型上下文窗口
AI_MAX_PROMPT_CHARS=120000
AI_TEMPERATURE=0.2

# AI 提供商 2（可选故障转移）
AI_2_API_KEY=
AI_2_BASE_URL=
AI_2_MODEL=

# 交易与行情
TRADING_SYMBOLS=BTC/USDT,ETH/USDT,BNB/USDT,SOL/USDT,DOGE/USDT
TRADING_INTERVAL_MINUTES=3
CANDLE_LIMIT=300
# 每个交易对每个周期输出的 K 线根数；调大会显著增加提示词体积
KLINE_DISPLAY_LIMIT=30

# 配置化风控；可按实验方案调整，不可由 AI 绕过
# 单笔与仓位上限均按名义价值计算（名义价值 = 保证金 × 杠杆）
RISK_MAX_LEVERAGE=20
RISK_MAX_SINGLE_TRADE_USDT=1000
RISK_MAX_POSITION_NOTIONAL_USDT=3000
RISK_MAX_TOTAL_NOTIONAL_USDT=5000
RISK_MIN_FREE_BALANCE_USDT=0
RISK_REQUIRE_PROTECTIVE_ORDER=true
# 保护单触发价与现价的最小间距百分比，避免开仓即被扫损；0 表示关闭
RISK_MIN_PROTECTIVE_DISTANCE_PERCENT=0.3

# 本地开发默认使用 instance/opennof1.db
DATABASE_URL=
AUTO_CREATE_SCHEMA=true

# Docker Compose 额外需要
# 当前 Compose 会将密码嵌入连接 URL，请仅使用字母、数字、下划线、点号和短横线
POSTGRES_PASSWORD=请替换为仅含安全字符的数据库密码
HOST_BIND_ADDRESS=127.0.0.1
